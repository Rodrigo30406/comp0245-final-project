# Optional local configuration. Copy this file to .env at the project root.
# Leave ROBOENV_ROOT unset to detect RoboEnv beside this project automatically.
# For another location, use an absolute path; quote paths containing spaces.
# ROBOENV_ROOT="/absolute/path/to/RoboEnv"

# 0 opens the simulator window; 1 runs without a GUI.
ROBOENV_HEADLESS=0

# Step-cap threshold, not mandatory duration. The lecturer checks it after stepping.
# At dt=0.001, 40000 is about 40 s; executed steps can slightly exceed the threshold.
# Independent of base_controller.nav_timeout (25 s) in experiment_specs/expert/default.json.
ROBOENV_MAX_STEPS=40000
