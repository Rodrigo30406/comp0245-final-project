{
  "attention": {
    "cell": "causal_transformer",
    "d_model": 64,
    "episodes_per_batch": 8,
    "ffn": 128,
    "head_width": 128,
    "heads": 4,
    "layers": 2,
    "memory_stride_steps": 20,
    "positional_encoding": "none (causal mask orders tokens, the clock input carries time)",
    "reaction_period_steps": 1,
    "state_reset": "every episode",
    "window_s": 20.0,
    "window_tokens": 1000
  },
  "backend": "pytorch",
  "clock_horizon_s": 40.0,
  "input_features": "raw21_targetpolar_clock_v1",
  "keep_expert_failures": false,
  "mlp": {
    "alpha": 0.0001,
    "batch_size": 1024,
    "hidden_layer_sizes": [
      128,
      128
    ],
    "learning_rate": 0.001,
    "max_epochs": null,
    "min_delta": 0.0,
    "patience": 40,
    "seed": 2
  },
  "model": "mlp",
  "name": "mlp_128_128_pytorch_cuda_patience_only_seed2_expert_successes_only_patience40",
  "normalization": "standard_scaler_training_only",
  "primary_metric": "episode_macro_balanced_nrmse",
  "sample_weighting": "uniform_transition",
  "split_seed": 20261025,
  "torch": {
    "data_placement": "auto",
    "deterministic": true,
    "device": "cuda",
    "validation_batch_size": 16384
  },
  "validation_fraction": 0.2
}
